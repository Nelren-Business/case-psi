---
// Hero.astro
import { Image } from 'astro:assets';

// O Astro resolverá o path e fará a otimização no build.
import heroBackground from '../../assets/fundo-dashboard.avif'; 
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="container hero-grid">
    
    <!-- Lado Esquerdo (60% — Colunas 1 a 7) -->
    <div class="hero-content">
      <span class="micro-badge">Estudo de caso • psicologia Clínica & Marketing</span>
      
      <h1 id="hero-title" class="title">
        Construindo uma clínica autêntica e próspera com ética para um psicólogo recém-formado
      </h1>
      
      <p class="description">
        Como um investimento estratégico em marketing bem executado com uma parceria produtiva profissional, geraram um início de carreira na psicologia clínica extremamente promissor e ético.
      </p>
      
      <div class="cta-group">
        <a href="#case-completo" class="btn btn-primary">Ler estudo de caso</a>
        <a href="#proposta" class="btn btn-outline">Ver valores & condições</a>
      </div>
    </div>

    <!-- Lado Direito (40% — Colunas 8 a 12) com Fundo Otimizado -->
    <div class="hero-dashboard">
      
      <Image 
        src={heroBackground} 
        alt="Ambiente de clínica de psicologia" 
        class="dashboard-bg-image"
        loading="eager"
        fetchpriority="high"
      />

      <!-- Adicionamos a classe 'animate-on-scroll' aqui -->
      <div class="dashboard-card animate-on-scroll">
        <ul class="kpi-list">
          <li class="kpi-item">
            <!-- Usamos <span> com data-count para o JS interceptar e animar -->
            <span class="kpi-value">Acima de <span data-count="5">0</span> meses</span>
            <span class="kpi-label">Tempo médio dos pacientes na psicoterapia</span>
          </li>
          <li class="kpi-item">
            <span class="kpi-value">+ R$ <span data-count="5195">0</span><small>/mês</small></span>
            <span class="kpi-label">Aumento na renda do psicólogo em 1 ano e meio</span>
          </li>
          <li class="kpi-item">
            <span class="kpi-value"><span data-count="100">0</span>% Ético</span>
            <span class="kpi-label">Em conformidade com CRP</span>
          </li>
          <li class="kpi-item">
            <span class="kpi-value">R$ <span data-count="120">0</span> &rarr; R$ <span data-count="160">0</span></span>
            <span class="kpi-label">Aumento no valor da sessão</span>
          </li>
        </ul>
      </div>
    </div>

  </div>
</section>

<style>
  /* ==========================================================================
     Suas Estilizações Base Mantidas (Omitindo o que não mudou para brevidade)
     ========================================================================== */
  .hero-section { padding: 3rem 1rem; font-family: var(--font-sans); color: var(--color-primary); }
  .container { max-width: 1200px; margin: 0 auto; }
  .hero-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 3rem; align-items: center; }
  .hero-content { grid-column: span 7; }
  .hero-dashboard {
    grid-column: span 5; position: relative; display: flex; align-items: center; justify-content: center;
    border-radius: 16px; overflow: hidden; padding: 2.5rem;
  }
  .dashboard-bg-image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; z-index: 0; }
  
  .dashboard-card {
    position: relative; z-index: 1; width: 100%; background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.4); border-radius: 12px;
    padding: 2rem; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  }

  .micro-badge { display: inline-block; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; color: var(--color-accent); text-transform: uppercase; margin-bottom: 1.5rem; }
  .title { font-size: 2.5rem; line-height: 1.2; font-weight: 800; margin: 0 0 1.5rem 0; color: var(--color-primary); }
  .description { font-size: 1.125rem; line-height: 1.6; color: var(--color-text-body); margin: 0 0 2rem 0; }
  
  .cta-group { display: flex; gap: 1rem; flex-wrap: wrap; --color-border: #cbd5e1; --color-accent-hover: #032f42; }
  .btn { padding: 0.75rem 1.5rem; font-size: 1rem; font-weight: 600; border-radius: 6px; text-decoration: none; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: inline-flex; align-items: center; justify-content: center; }
  .btn-primary { background-color: var(--color-accent); color: #ffffff; border: 2px solid var(--color-accent); }
  .btn-primary:hover { background-color: var(--color-accent-hover); border-color: var(--color-accent-hover); transform: translateY(-2px); box-shadow: 0 6px 15px rgba(5, 67, 94, 0.25); }
  .btn-outline { background-color: transparent; color: var(--color-primary); border: 2px solid var(--color-border); }
  .btn-outline:hover { background-color: var(--color-primary); color: #ffffff; border-color: var(--color-primary); transform: translateY(-2px); box-shadow: 0 6px 15px rgba(5, 67, 94, 0.15); }

  .kpi-list { list-style: none; padding: 0; margin: 0 0 1.5rem 0; display: flex; flex-direction: column; gap: 1.5rem; }
  .kpi-item { display: flex; flex-direction: column; gap: 0.25rem; }
  .kpi-value { font-size: 1.5rem; font-weight: 700; color: var(--color-accent); }
  .kpi-value small { font-size: 1rem; font-weight: 500; }
  .kpi-label { font-size: 0.95rem; color: var(--color-text-body); line-height: 1.4; }

  /* ==========================================================================
     CSS de Animação de Entrada
     ========================================================================== */
  /* Estado inicial do card principal */
  .animate-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Estado inicial dos itens da lista (efeito de "cascata") */
  .kpi-item {
    opacity: 0;
    transform: translateX(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  /* Quando o JS adiciona 'is-visible', anima o card... */
  .animate-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ...e anima os filhos em cascata com atraso (Staggering) */
  .animate-on-scroll.is-visible .kpi-item {
    opacity: 1;
    transform: translateX(0);
  }
  .animate-on-scroll.is-visible .kpi-item:nth-child(1) { transition-delay: 0.2s; }
  .animate-on-scroll.is-visible .kpi-item:nth-child(2) { transition-delay: 0.35s; }
  .animate-on-scroll.is-visible .kpi-item:nth-child(3) { transition-delay: 0.5s; }
  .animate-on-scroll.is-visible .kpi-item:nth-child(4) { transition-delay: 0.65s; }

  @media (max-width: 992px) {
    .hero-section{
      padding: 0;
    }

    .hero-grid { 
      /* Destrói as 12 colunas e assume 1 coluna única para resolver os gaps fantasmas */
      grid-template-columns: 1fr; 
      gap: 1.5rem; 
    }
    
    .hero-dashboard { 
      grid-column: 1 / -1; /* Ocupa a grid inteira de forma segura */
      padding: 2rem; /* Reduzido para sobrar mais espaço na tela */
      order: 1; 
    }
    
    .hero-content { 
      grid-column: 1 / -1; 
      padding: 1rem; /* Removido padding lateral excessivo, o .hero-section já tem 1rem */
      order: 2; 
    }

    .kpi-value{
      font-size: 1.2rem;
    }

    .kpi-label{
      font-size: 0.85rem;
    }

    .title{
      font-size: 1.8rem;
    }

    .description{
      font-size: 0.9rem;
    }
    
    .dashboard-card {
      padding: 1.5rem; /* Ajuste fino: 2rem originais espremem muito o texto no mobile */
    }

    .cta-group { flex-direction: column; gap: 0.75rem; margin-bottom: 3rem; }
    .btn { width: 100%; font-size: 0.9rem;}
  }
</style>

<!-- Script de Animação Otimizado (Vanilla JS) -->
<script>
  const initCounters = () => {
    // Configuramos o observer para agir quando o card entrar 20% na viewport
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const card = entry.target;
          
          // 1. Dispara a animação CSS do Card (Fade/Translate)
          card.classList.add('is-visible');

          // 2. Localiza e anima os números apenas DENTRO deste card visível
          const counters = card.querySelectorAll('[data-count]');
          counters.forEach(counter => {
            const target = parseInt(counter.getAttribute('data-count'), 10);
            const duration = 2000; // 2 segundos de animação
            const startTimestamp = performance.now();

            const step = (currentTimestamp) => {
              const elapsed = currentTimestamp - startTimestamp;
              const progress = Math.min(elapsed / duration, 1);
              
              // Easing "easeOutQuart" (curva de desaceleração profissional)
              const easeProgress = 1 - Math.pow(1 - progress, 4);
              const currentVal = Math.floor(target * easeProgress);

              // Atualiza na tela formatando com pontos de milhar "pt-BR"
              counter.innerText = currentVal.toLocaleString('pt-BR');

              // Continua o loop enquanto não bater 100% (progress = 1)
              if (progress < 1) {
                requestAnimationFrame(step);
              } else {
                counter.innerText = target.toLocaleString('pt-BR'); // Garante valor final
              }
            };
            
            // Inicia o frame
            requestAnimationFrame(step);
          });

          // Desobserva para a animação ocorrer apenas uma vez
          obs.unobserve(card);
        }
      });
    }, { threshold: 0.2 });

    // Seleciona todos os cards com a classe
    document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
  };

  // Suporte avançado caso você ative View Transitions do Astro no futuro
  document.addEventListener('astro:page-load', initCounters);
  // Execução padrão
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCounters);
  } else {
    initCounters();
  }
</script>