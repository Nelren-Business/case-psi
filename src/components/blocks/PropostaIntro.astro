---
// Define as propriedades esperadas pelo componente usando TypeScript
interface Props {
  nomePsicologa: string;
}

// Extrai a prop para ser usada no template
const { nomePsicologa } = Astro.props;
---

<section id="proposta" class="proposta-intro content-area" aria-labelledby="intro-title">
  <div class="container text-center">
    
    <!-- 1. Header Narrativo -->
    <header class="intro-header">
      <span class="badge" role="text">Valores & Condições</span>
      
      <h2 id="intro-title" class="title">
        Podemos também te ajudar a construir uma clínica próspera juntos.
      </h2>
      
      <p class="subtitle">
        Abaixo, {nomePsicologa}, está tudo o que você precisa caso queira começar uma relação conosco, tudo bem?
      </p>
    </header>

    <!-- 2. Card de Solução Estratégica -->
    <article class="strategy-card">
      
      <!-- Bloco 1: A Recomendação Técnica -->
      <div class="card-block primary-block">
        <div class="card-label">
          <!-- Ícone SVG inline (Alvo/Estratégia) para performance e sem dependências -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm0-7c-1.65 0-3 1.35-3 3s1.35 3 3 3 3-1.35 3-3-1.35-3-3-3zm0 4c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/>
          </svg>
          <span>Sugestão técnica</span>
        </div>
        <h3 class="card-title">Anúncios no Instagram (Instagram Ads)</h3>
      </div>

      <!-- Divisor Visual Suave -->
      <hr class="card-divider" />

      <!-- Bloco 2: A Racional / Justificativa -->
      <div class="card-block secondary-block">
        <span class="reason-label">Por quê?</span>
        <p class="reason-text">
          Através desse estudo de caso desse psicólogo, o Instagram tende a ser mais eficiente e eficaz. 
          Além disso, {nomePsicologa}, você já tem um perfil ativo e não há necessidade de postar toda hora.
        </p>
      </div>

    </article>
  </div>
</section>

<style>
  /* ==========================================================================
     Scoped CSS do Componente
     ========================================================================== */
  
  .text-center {
    margin-top: 9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* --- Header Narrativo --- */
  .intro-header {
    max-width: 700px; /* Limita caracteres por linha para leitura ideal */
    margin: 0 auto 3rem auto;
    text-align: center;
  }

  .badge {
    display: inline-block;
    background-color: var(--color-background-alt);
    color: var(--color-primary);
    padding: 0.35rem 1.2rem;
    border-radius: 9999px; /* Pill shape */
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
    border: 1px solid #EAEFF0; /* Toque sutil de refinamento */
  }

  .title {
    margin-bottom: 1rem;
    /* Usa os estilos globais de H2, apenas reescrevemos o margin base */
  }

  .subtitle {
    font-size: 1.125rem;
    color: #4a4a4a; /* Cinza escuro para contraste suave com o H2 (preto/primário) */
    line-height: 1.6;
    margin: 0;
  }

  /* --- Card de Solução Estratégica --- */
  .strategy-card {
    width: 100%;
    max-width: 800px;
    background-color: var(--color-background);
    border: 1px solid #e5e5e5;
    border-radius: 16px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.06); /* Peso consultivo solicitado */
    text-align: left; /* Leitura de relatório técnico */
    overflow: hidden; /* Mantém as bordas arredondadas nos blocos internos */
  }

  .card-block {
    padding: 2.5rem;
  }

  .card-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-info); /* Cor de destaque para label */
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .card-title {
    margin: 0;
    /* Herda fonte global de headings, mas com tamanho específico pro card */
    font-size: 1.5rem; 
  }

  .card-divider {
    border: none;
    height: 1px;
    background-color: #eaeaea;
    margin: 0;
  }

  .secondary-block {
    /* Leve contraste para separar visualmente a justificativa */
    background-color: var(--color-background-alt); 
  }

  .reason-label {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .reason-text {
    margin: 0;
    color: var(--color-text-main);
    line-height: 1.6;
    opacity: 0.9;
  }

  /* --- Responsividade --- */
  @media all and (max-width: 767px) {
    .proposta-intro{
      margin-bottom: 2rem;
      padding: 1rem;
    }

    .intro-header {
      margin-bottom: 2rem;
    }
    
    .badge {
      font-size: 0.75rem;
      margin-bottom: 1rem;
    }

    .subtitle {
      font-size: 1rem;
    }

    .card-block {
      padding: 1.5rem;
    }

    .card-title {
      font-size: 1.25rem;
    }
  }
</style>