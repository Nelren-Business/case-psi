---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import myFavicon from '../assets/favicon.png';
import FloatingButton from '../components/FloatingButton.astro';
const favicon = await getImage({ src: myFavicon });

const { title, description } = Astro.props;

import MicrosoftClarity from '../components/MicrosoftClarity.astro';
import FloatingButton from '../components/FloatingButton.astro';


---
<!doctype html>
<html lang="pt-br">
    <head>
        <MicrosoftClarity />
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href={favicon.src} />
        <title>{title}</title>
    </head>
    <body>
        <FloatingButton />
        <slot />
    </body>
</html>